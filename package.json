{
  "name": "armour-pursuit",
  "version": "1.0.0",
  "private": true,
  "description": "Armour Pursuit: a job search command center that runs on your own computer.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "vite dev app_build/frontier --host 127.0.0.1 --port 5196 --strictPort",
    "dev": "vite dev app_build/frontier --host 127.0.0.1 --port 5196 --strictPort",
    "test": "jest",
    "typecheck": "tsc --noEmit -p app_build/frontier && tsc --noEmit -p app_build/server",
    "cli": "tsx app_build/server/jobhunt/cli.ts",
    "setup:browser": "puppeteer browsers install chrome"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@vitejs/plugin-react": "^6.0.0",
    "d3": "^7.9.0",
    "dotenv": "^16.3.1",
    "motion": "^13.1.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^25.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "rootDir": "app_build/server",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "diagnostics": false,
          "tsconfig": "app_build/server/tsconfig.json"
        }
      ]
    }
  }
}
