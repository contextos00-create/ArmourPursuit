# Copy this file to .env (same folder) and fill in what you use.
# Everything here is optional. Without it the app still runs; updates show in the bell only.
# Never commit .env.

# Text messages (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
JOBHUNT_SMS_TO=

# Email replies and bounce-backs (Gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=
