{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": ["jobhunt/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "data"]
}
